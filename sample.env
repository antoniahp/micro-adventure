# Template for local.env. Copy it and fill in your own values:
#     cp sample.env local.env        (or: make setup)
# sample.env is committed to git and holds NO secrets. local.env is ignored by git.
# After changing local.env, apply it with: docker compose up -d

# --- Django ---
DJANGO_SECRET_KEY=change-me
DEBUG=true

# --- Gemma through Ollama (Ollama runs on your machine, outside Docker) ---
# Only for a hosted Ollama behind a proxy (see scripts/gpu-droplet-setup.sh). Leave empty for local Ollama.
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma3:latest
# Seconds the app waits for the model before using the template fallback.
# The first request after starting Ollama loads the model, which can take 30s or more.
OLLAMA_TIMEOUT_SECONDS=60
# "ollama" checks photos with the vision model. "trusting" accepts every photo.
PHOTO_VERIFIER=trusting

# --- Sentry (optional) ---
# Project settings > Client Keys (DSN) in sentry.io. Empty = Sentry off.
SENTRY_DSN=
# Label for the traces: development here, production on Render.
SENTRY_ENVIRONMENT=development

# --- ElevenLabs (optional) ---
# Lets people answer with a voice note. Empty = they can only write.
ELEVENLABS_API_KEY=

# --- Telegram reminders (optional) ---
# Bot created with @BotFather. Empty = the Reminders tab says they are off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Secret used by cron-job.org to call /api/reminders/run?key=... and /api/telegram/setup?key=...
REMINDERS_KEY=
