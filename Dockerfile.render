# Production image for Render: builds the web client, then serves it and the API from one service.
# Local development keeps using Dockerfile (Vite and runserver, with live reload).

FROM node:22-alpine AS web
WORKDIR /web
# Vite bakes this into the built JS at compile time, so it has to arrive as a build argument, not a
# runtime environment variable. It's the public Google OAuth client id, not a secret - it's visible in
# every browser request, so a plain build ARG is fine. Render turns any dashboard env var of this name
# into a build argument automatically (see "Using Secrets with Docker" in Render's docs for actual secrets).
ARG VITE_GOOGLE_CLIENT_ID
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
COPY web/package.json web/package-lock.json* ./
RUN npm install --no-audit --no-fund
COPY web ./
RUN npm run build

FROM python:3.12-slim
WORKDIR /usr/src/app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 POETRY_VIRTUALENVS_CREATE=false POETRY_NO_INTERACTION=1
RUN pip install --upgrade pip && pip install "poetry==2.5.1"
COPY pyproject.toml poetry.lock ./
RUN poetry install --no-root --only main
RUN pip install tzdata
COPY src ./src
COPY --from=web /web/dist ./web_dist

# Applies migrations, collects the admin's static files and starts gunicorn on the port Render gives us.
# One process with 8 threads: a slow call to the model (a photo, a walk) must not block every other request, health checks included.
CMD ["sh", "-c", "python src/manage.py migrate && python src/manage.py collectstatic --noinput && gunicorn --chdir src core.wsgi:application --bind 0.0.0.0:${PORT:-8000} --workers 1 --threads 8 --timeout 120 --access-logfile - --logger-class core.gunicorn_logging.RedactingLogger"]
